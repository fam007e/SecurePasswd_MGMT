name: Request Signing

on:
  push:
    tags:
      - "v*"

permissions: {}

jobs:
  dispatch:
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    steps:
      - name: Dispatch to OSSign
        id: dispatch
        uses: OSSign/actions/workflow/dispatch@0e67f66216cad6f95810cec071d213d8eee2ce28 # v3
        with:
          dispatch_only: true
