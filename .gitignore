# Build artifacts and compiled files
*.o
*.so
*.a
*.dll
*.exe
securepass

# Test database files
test_vault.db
*.salt

# Data files - contains sensitive user data
data/*
!data/.gitkeep

# Dependencies and libraries
lib/*
!lib/README.md
build/
dist/

# Python virtual environment
.venv/

# IDE and editor configuration
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# LLM guidance files
GEMINI.md

# CMake build artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Packaging artifacts
.SRCINFO
*.pkg.tar.zst
*.deb
*.dmg
*.nsi

# Generated docs (doxygen/html) — CI builds & deploys to gh-pages
docs/api/
!docs/.gitkeep

# GDB logging env
.gdbinit

# Termux error log
termux-err-log/

# Mimosa security-hook session state (plugin working files;
# nested copies exist wherever the hook's cwd was)
.mimosa/
**/.mimosa/
