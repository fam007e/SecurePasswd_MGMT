/* ============================================================
   SecurePasswd MGMT — Light Theme (App-icon accent on Snow Storm)
   Tokens are defined in docs/DESIGN_TOKENS.md and mirrored in
   the Android app (ui/theme/Color.kt). Keep both in sync.
   ============================================================ */

/* -- Surface roles -- */
/* background      #ECEFF4  (Snow Storm)     */
/* surface         #FFFFFF  (cards, inputs)  */
/* surfaceHover    #E5E9F0                   */
/* outline         #D8DEE9  (borders)        */
/* onSurface       #434343  (text)           */
/* primary         #d97dbc  (app-icon pink)  */
/* primaryHover    #c77575                   */
/* primaryActive   #8b8484                   */

QMainWindow,
QDialog {
    background-color: #ECEFF4;
    color: #434343;
}

QLabel {
    color: #434343;
    background: transparent;
}

/* -- Lists -- */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 6px;
    color: #434343;
    padding: 4px;
    outline: none;
}
QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background-color: #d97dbc;
    color: #FFFFFF;
}
QListWidget::item:hover:!selected {
    background-color: #E5E9F0;
}

/* -- Bars -- */
QToolBar {
    background-color: #ECEFF4;
    border: none;
    spacing: 4px;
    padding: 4px;
}
QToolBar QToolButton {
    color: #434343;
    border-radius: 6px;
    padding: 6px;
}
QToolBar QToolButton:hover {
    background-color: #D8DEE9;
}
QToolBar QToolButton:pressed {
    background-color: #E5E9F0;
}
QStatusBar {
    background-color: #ECEFF4;
    color: #434343;
}
QMenuBar {
    background-color: #ECEFF4;
    color: #434343;
}
QMenuBar::item:selected {
    background-color: #D8DEE9;
    border-radius: 4px;
}
QMenu {
    background-color: #FFFFFF;
    color: #434343;
    border: 1px solid #D8DEE9;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #D8DEE9;
}

/* -- Progress (TOTP indicator) -- */
QProgressBar {
    border: 1px solid #D8DEE9;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #434343;
    text-align: center;
    height: 14px;
}
QProgressBar::chunk {
    background-color: #d97dbc;
    border-radius: 5px;
}

/* -- Buttons -- */
QPushButton {
    background-color: #d97dbc;
    color: #FFFFFF;
    border: 1px solid #d97dbc;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #c77575;
    border-color: #c77575;
}
QPushButton:pressed {
    background-color: #8b8484;
    border-color: #8b8484;
}
QPushButton:disabled {
    background-color: #D8DEE9;
    color: #A5A9B0;
    border-color: #D8DEE9;
}
QPushButton:focus {
    border: 1px solid #8b8484;
}
QToolButton {
    color: #434343;
    border-radius: 6px;
    padding: 4px;
}
QToolButton:hover {
    background-color: #D8DEE9;
}

/* -- Inputs -- */
QLineEdit {
    background-color: #FFFFFF;
    color: #434343;
    border: 1px solid #D8DEE9;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #d97dbc;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 1px solid #d97dbc;
}
QLineEdit:disabled {
    color: #A5A9B0;
}
QComboBox {
    background-color: #FFFFFF;
    color: #434343;
    border: 1px solid #D8DEE9;
    border-radius: 6px;
    padding: 6px 8px;
}
QComboBox:focus {
    border: 1px solid #d97dbc;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #434343;
    border: 1px solid #D8DEE9;
    selection-background-color: #D8DEE9;
}
QCheckBox, QRadioButton {
    color: #434343;
    spacing: 8px;
    padding: 4px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #D8DEE9;
    border-radius: 4px;
    background: #FFFFFF;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #d97dbc;
    border-color: #d97dbc;
}

/* -- Scrollbars (slim, non-intrusive) -- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #D8DEE9;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #c77575;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #D8DEE9;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #c77575;
}

/* -- Tooltips -- */
QToolTip {
    background-color: #FFFFFF;
    color: #434343;
    border: 1px solid #D8DEE9;
    border-radius: 4px;
    padding: 4px 8px;
}

/* -- Cards (sync dialog, status/summary panels) -- */
QFrame#statusCard,
QFrame#summaryCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DEE9;
    border-radius: 12px;
}
QFrame#statusCard QLabel {
    color: #434343;
    font-weight: 500;
}
QFrame#summaryCard QPlainTextEdit {
    background: transparent;
    border: none;
    color: #434343;
}
QFrame#summaryCard[variant="success"] {
    border: 1px solid #A3BE8C;
}
QFrame#summaryCard[variant="error"] {
    border: 1px solid #BF616A;
}
